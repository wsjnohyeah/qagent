# Safe local defaults. Never commit a real .env file.
APP_ENV=development
# Development proves correctness with bounded samples; production owns long-horizon jobs.
DEVELOPMENT_MAX_BACKFILL_DAYS=120
DEVELOPMENT_MAX_INTRADAY_BACKFILL_DAYS=7
TRADING_MODE=shadow
LIVE_TRADING_ENABLED=false
GLOBAL_NEW_EXPOSURE_PAUSED=false
DATABASE_URL=sqlite+pysqlite:///./work/agentic_quant.db
REDIS_URL=
OBJECT_STORE_ROOT=./work/object-store
RISK_POLICY_PATH=./configs/risk_policy.yaml
RESTRICTED_SECURITIES_PATH=./configs/restricted_securities.yaml
AUTO_MIGRATE=true

# Add these only to the ignored .env file. Never paste or commit real keys.
ALPACA_API_KEY=
ALPACA_API_SECRET=
SEC_USER_AGENT=
ENABLE_SOCIAL_AGGREGATES=false
SOCIAL_AGGREGATE_URL=
SOCIAL_AGGREGATE_TOKEN=
LLM_OPENAI_API_KEY=
LLM_META_API_KEY=
LLM_ROUTING_PATH=./configs/model_routing.yaml
LLM_BUDGET_PATH=./configs/llm_budget.yaml
RESEARCH_PROMOTION_POLICY_PATH=./configs/research_promotion_policy.yaml
ML_POLICY_PATH=./configs/ml_policy.yaml
ALPACA_STOCK_FEED=sip
ALPACA_OPTION_FEED=opra
MARKET_CALENDAR=XNYS
